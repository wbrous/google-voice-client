{
  "name": "google-voice-discord-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun --env-file=.env run index.ts",
    "login": "bun run bin/login.ts",
    "cookies:export": "bun run bin/cookies.ts export",
    "cookies:import": "bun run bin/cookies.ts import",
    "capture-tokens": "bun --env-file=.env run bin/refresh-tokens.ts",
    "refresh-tokens-loop": "LOOP=1 bun --env-file=.env run bin/refresh-tokens.ts"
  },
  "dependencies": {
    "google-voice-client": "link:google-voice-client",
    "discord.js-selfbot-youtsuho-v13": "3.7.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2"
  }
}
