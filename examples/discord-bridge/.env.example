# Google Voice session — see the main repo's .env.example
GV_API_KEY=
GV_AUTH_USER=0
GV_COOKIE=

# Discord selfbot — YOUR USER token (ToS risk: Discord bans selfbots)
DISCORD_TOKEN=

# Who/where to bridge
BRIDGE_DM_USER_ID=
BRIDGE_PHONE=
# Optional: the Google Contact profile image ("View contact" > avatar URL).
# Shown as the sender avatar on forwarded messages so a wrong number is
# obvious, and used by the automated token-refresh to verify the right
# contact was selected.
BRIDGE_CONTACT_IMAGE=

# Optional: enable Discord→phone sends. Both values are minted live by
# Google's web client (WAA/BotGuard + reCAPTCHA) — grab a fresh pair with:
#   bun run capture-tokens
GV_SEND_ATTESTATION_TOKEN=
GV_SEND_RECAPTCHA_TOKEN=

# Seconds between Voice poll cycles (default 5)
GV_POLL_INTERVAL_SEC=5
# Set to 1 for verbose logging of every Voice event and Discord filter decision
DEBUG=
