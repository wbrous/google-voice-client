{
  "name": "google-voice-client",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/USERNAME/google-voice-client.git"
  },
  "keywords": [
    "google-voice",
    "sms",
    "mms",
    "websocket",
    "unofficial-api"
  ],
  "type": "module",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && bun build ./src/index.ts --outdir dist --target node --format esm --external playwright --external @mherod/get-cookie && tsc",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "refresh-cookies": "bun run bin/refresh-cookies.ts",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "playwright": "^1.62.1",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "sharp": "^0.35.4"
  },
  "peerDependencies": {
    "@mherod/get-cookie": "^4.5.0",
    "playwright": "^1.62.1"
  },
  "peerDependenciesMeta": {
    "@mherod/get-cookie": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  }
}
