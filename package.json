{
  "name": "google-voice-ws",
  "version": "0.1.0",
  "description": "Unofficial client for Google Voice's internal web API",
  "license": "MIT",
  "type": "module",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && bun build ./src/index.ts --outdir dist --target node --format esm --external playwright && tsc",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "refresh-cookies": "bun run bin/refresh-cookies.ts",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "playwright": "^1.62.1",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "sharp": "^0.35.4"
  },
  "peerDependencies": {
    "playwright": "^1.62.1"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
