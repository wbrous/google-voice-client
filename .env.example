# Google Voice's internal web API key (public, sent by every browser client — not secret).
GV_API_KEY=

# Which signed-in Google account to act as (X-Goog-AuthUser). Usually 0 or 1.
GV_AUTH_USER=0

# Version string Voice's web client reports itself as (X-Client-Version).
GV_CLIENT_VERSION=967950005

# Full `Cookie` header value from an authenticated voice.google.com session.
# You can fill this by hand (DevTools > Network > any XHR to
# clients6.google.com > Request Headers), or keep it fresh automatically:
#   bun add playwright && bun run refresh-cookies
# (first run opens a browser for you to log in; later runs are headless and
# can go on a cron job / systemd timer).
# Must include SAPISID (or __Secure-3PAPISID); GV_SAPISID below is derived
# from it automatically if not set explicitly.
GV_COOKIE=

# Optional: override SAPISID explicitly instead of parsing it out of GV_COOKIE.
GV_SAPISID=
